<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_oauth_event_cleanup" model="ir.cron">
            <field name="name">OW MCP OAuth: Event Log Cleanup</field>
            <field name="model_id" ref="model_ow_mcp_oauth_event"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_old_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_oauth_purge_expired" model="ir.cron">
            <field name="name">OW MCP OAuth: Purge Expired Codes/Tokens</field>
            <field name="model_id" ref="model_ow_mcp_oauth_config"/>
            <field name="state">code</field>
            <field name="code">model.sudo().get_singleton()._cron_purge_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
