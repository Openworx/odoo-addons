<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oauth_event_list" model="ir.ui.view">
        <field name="name">ow.mcp.oauth.event.list</field>
        <field name="model">ow.mcp.oauth.event</field>
        <field name="arch" type="xml">
            <list string="OAuth Events" create="false" edit="false">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="client_id"/>
                <field name="user_id"/>
                <field name="ip"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_oauth_event_form" model="ir.ui.view">
        <field name="name">ow.mcp.oauth.event.form</field>
        <field name="model">ow.mcp.oauth.event</field>
        <field name="arch" type="xml">
            <form string="OAuth Event" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="client_id"/>
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="ip"/>
                            <field name="user_agent"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload_json" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oauth_event" model="ir.actions.act_window">
        <field name="name">OAuth Events</field>
        <field name="res_model">ow.mcp.oauth.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
