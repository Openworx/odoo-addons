<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="consent_template" name="MCP OAuth Consent">
        <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>Authorize MCP access</title>
            <link rel="stylesheet" type="text/css"
                  href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
            <style>
                body { background: #f8f9fa; padding-top: 4rem; }
                .card { max-width: 520px; margin: 0 auto; }
                .scope-list { list-style: none; padding-left: 0; }
                .scope-list li {
                    padding: .5rem .75rem;
                    background: #f1f3f5;
                    border-radius: .375rem;
                    margin-bottom: .5rem;
                    font-family: ui-monospace, SFMono-Regular, monospace;
                }
                .meta { color: #6c757d; font-size: .875rem; }
            </style>
        </head>
        <body>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3">Authorize MCP access</h4>
                    <p>
                        <strong>
                            <t t-esc="client.client_name or client.client_id"/>
                        </strong>
                        is requesting access to your Odoo MCP server.
                    </p>
                    <p class="meta">
                        Logged in as
                        <strong><t t-esc="request.env.user.login"/></strong>.
                    </p>

                    <h6 class="mt-4">Requested scopes</h6>
                    <ul class="scope-list">
                        <t t-foreach="scopes" t-as="s">
                            <li>
                                <t t-esc="s"/>
                                <t t-if="s == 'mcp:read'">
                                    — read records and schema
                                </t>
                                <t t-if="s == 'mcp:write'">
                                    — create, update, and delete records
                                </t>
                            </li>
                        </t>
                    </ul>

                    <p class="meta mt-3">
                        Redirect URI:
                        <code><t t-esc="redirect_uri"/></code>
                    </p>
                    <p class="meta">
                        Bound resource:
                        <code><t t-esc="resource"/></code>
                    </p>

                    <form method="post" action="/ow_mcp/oauth/authorize"
                          class="mt-4">
                        <input type="hidden" name="csrf_token"
                               t-att-value="csrf_token"/>
                        <input type="hidden" name="client_id"
                               t-att-value="client.client_id"/>
                        <input type="hidden" name="redirect_uri"
                               t-att-value="redirect_uri"/>
                        <input type="hidden" name="scope"
                               t-att-value="scope_str"/>
                        <input type="hidden" name="state"
                               t-att-value="state"/>
                        <input type="hidden" name="code_challenge"
                               t-att-value="code_challenge"/>
                        <input type="hidden" name="code_challenge_method"
                               t-att-value="code_challenge_method"/>
                        <input type="hidden" name="resource"
                               t-att-value="resource"/>

                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input"
                                   id="remember" name="remember" value="1"
                                   checked="checked"/>
                            <label class="form-check-label" for="remember">
                                Remember this decision
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" name="decision" value="allow"
                                    class="btn btn-primary flex-grow-1">
                                Allow
                            </button>
                            <button type="submit" name="decision" value="deny"
                                    class="btn btn-outline-secondary">
                                Deny
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </body>
        </html>
    </template>
</odoo>
