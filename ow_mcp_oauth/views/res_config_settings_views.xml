<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_oauth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ow_mcp_oauth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ow_mcp_server.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='ow_mcp_server']" position="inside">

                <block title="OAuth 2.1" name="ow_mcp_oauth">
                    <setting id="ow_mcp_oauth_enabled"
                             string="Enable OAuth 2.1"
                             help="When on, /mcp accepts both OAuth bearer tokens and API keys, and the discovery endpoints are served. When off, /mcp only accepts API keys.">
                        <field name="ow_mcp_oauth_enabled"/>
                    </setting>
                    <setting id="ow_mcp_oauth_dcr_enabled"
                             string="Enable Dynamic Client Registration"
                             help="When on, any client may POST to /ow_mcp/oauth/register (rate-limited per IP). Disable to require admins to register clients manually.">
                        <field name="ow_mcp_oauth_dcr_enabled"/>
                    </setting>
                    <setting id="ow_mcp_oauth_canonical_resource_uri"
                             string="Canonical resource URI"
                             help="The audience embedded in issued tokens (RFC 8707). Defaults to &lt;web.base.url&gt;/mcp. Override only if the MCP server is reverse-proxied at a different URL.">
                        <field name="ow_mcp_oauth_canonical_resource_uri"
                               placeholder="https://odoo.example.com/mcp"/>
                    </setting>
                </block>

                <block title="OAuth Lifetimes" name="ow_mcp_oauth_ttls">
                    <setting id="ow_mcp_oauth_access_token_ttl_seconds"
                             string="Access token TTL (seconds)"
                             help="Default 900 (15 min).">
                        <field name="ow_mcp_oauth_access_token_ttl_seconds"/>
                    </setting>
                    <setting id="ow_mcp_oauth_refresh_token_ttl_seconds"
                             string="Refresh token TTL (seconds)"
                             help="Default 2,592,000 (30 days).">
                        <field name="ow_mcp_oauth_refresh_token_ttl_seconds"/>
                    </setting>
                    <setting id="ow_mcp_oauth_auth_code_ttl_seconds"
                             string="Authorization code TTL (seconds)"
                             help="Default 60 seconds.">
                        <field name="ow_mcp_oauth_auth_code_ttl_seconds"/>
                    </setting>
                    <setting id="ow_mcp_oauth_consent_remember_days"
                             string="Remember consent (days)"
                             help="0 disables consent caching.">
                        <field name="ow_mcp_oauth_consent_remember_days"/>
                    </setting>
                    <setting id="ow_mcp_oauth_unused_client_purge_days"
                             string="Purge unused DCR clients after (days)"
                             help="Auto-delete dynamically-registered clients that have never been used. 0 disables.">
                        <field name="ow_mcp_oauth_unused_client_purge_days"/>
                    </setting>
                    <setting id="ow_mcp_oauth_dcr_rate_limit_per_ip_per_hour"
                             string="DCR rate limit (per IP/hour)"
                             help="Per-worker; 0 disables the limit.">
                        <field name="ow_mcp_oauth_dcr_rate_limit_per_ip_per_hour"/>
                    </setting>
                </block>

                <block title="OAuth Signing Keys" name="ow_mcp_oauth_keys">
                    <setting id="ow_mcp_oauth_active_kid"
                             string="Active key id"
                             help="The current `kid` advertised on /ow_mcp/oauth/jwks.json and used to sign new access tokens.">
                        <field name="ow_mcp_oauth_active_kid" readonly="1"/>
                    </setting>
                    <setting id="ow_mcp_oauth_previous_kid"
                             string="Previous key id"
                             help="Kept after rotation so already-issued tokens stay valid until they expire naturally.">
                        <field name="ow_mcp_oauth_previous_kid" readonly="1"/>
                    </setting>
                    <setting string="Rotate signing key"
                             help="Generates a new RSA keypair, demotes the current public key to `previous`. New tokens use the new kid; existing tokens keep verifying until their natural expiry.">
                        <button name="action_ow_mcp_oauth_rotate_key"
                                type="object" string="Rotate now"
                                class="btn-primary"
                                confirm="Rotate the OAuth signing key? Existing tokens stay valid until they expire."/>
                    </setting>
                </block>

            </xpath>
        </field>
    </record>

</odoo>
