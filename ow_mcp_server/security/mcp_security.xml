<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Server</field>
        <field name="sequence">90</field>
    </record>

    <!-- Odoo 19: res.groups no longer has category_id; groups hang off a
         res.groups.privilege, which in turn points to the module category. -->
    <record id="res_groups_privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Server</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_mcp"/>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">MCP User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="comment">May call MCP tools subject to per-model access config.</field>
    </record>

    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
