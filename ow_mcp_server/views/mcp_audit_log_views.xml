<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_audit_log_list" model="ir.ui.view">
        <field name="name">ow.mcp.audit.log.list</field>
        <field name="model">ow.mcp.audit.log</field>
        <field name="arch" type="xml">
            <list string="MCP Audit Log" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="login"/>
                <field name="company_id" optional="show"/>
                <field name="method"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="error_message" optional="hide"/>
                <field name="ip_address" optional="hide"/>
                <field name="duration_ms"/>
                <field name="payload_bytes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_audit_log_form" model="ir.ui.view">
        <field name="name">ow.mcp.audit.log.form</field>
        <field name="model">ow.mcp.audit.log</field>
        <field name="arch" type="xml">
            <form string="MCP Audit Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="login"/>
                            <field name="company_id"/>
                            <field name="method"/>
                            <field name="tool_name"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="success" widget="boolean_toggle"/>
                            <field name="error_code"/>
                            <field name="error_message"/>
                            <field name="ip_address"/>
                            <field name="duration_ms"/>
                            <field name="payload_bytes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_payload" widget="ace" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Response">
                            <field name="response_summary" widget="ace" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_audit_log_search" model="ir.ui.view">
        <field name="name">ow.mcp.audit.log.search</field>
        <field name="model">ow.mcp.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="login"/>
                <field name="company_id"/>
                <field name="method"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <field name="ip_address"/>
                <filter string="Errors" name="errors" domain="[('success','=',False)]"/>
                <filter string="Last 24h" name="recent"
                        domain="[('create_date','&gt;=',(context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group by">
                    <filter string="User" name="grp_user" context="{'group_by':'login'}"/>
                    <filter string="Company" name="grp_company" context="{'group_by':'company_id'}"/>
                    <filter string="Tool" name="grp_tool" context="{'group_by':'tool_name'}"/>
                    <filter string="Model" name="grp_model" context="{'group_by':'model_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_audit_log" model="ir.actions.act_window">
        <field name="name">MCP Audit Logs</field>
        <field name="res_model">ow.mcp.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mcp_audit_log_search"/>
    </record>
</odoo>
