<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_model_access_tree" model="ir.ui.view">
        <field name="name">ow.mcp.model.access.list</field>
        <field name="model">ow.mcp.model.access</field>
        <field name="arch" type="xml">
            <list string="MCP Model Access">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="allow_read"/>
                <field name="allow_write"/>
                <field name="allow_create"/>
                <field name="allow_delete"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_model_access_form" model="ir.ui.view">
        <field name="name">ow.mcp.model.access.form</field>
        <field name="model">ow.mcp.model.access</field>
        <field name="arch" type="xml">
            <form string="MCP Model Access">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Permissions">
                        <field name="allow_read"/>
                        <field name="allow_write"/>
                        <field name="allow_create"/>
                        <field name="allow_delete"/>
                    </group>
                    <group string="Fine-grained">
                        <field name="allowed_fields_json"
                               placeholder='["name", "email", "country_id"]'/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="max_records"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_model_access" model="ir.actions.act_window">
        <field name="name">MCP Model Rules</field>
        <field name="res_model">ow.mcp.model.access</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
