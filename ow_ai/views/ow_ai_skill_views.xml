<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ow_ai_skill_view_list" model="ir.ui.view">
        <field name="name">ow.ai.skill.view.list</field>
        <field name="model">ow.ai.skill</field>
        <field name="arch" type="xml">
            <list string="AI Skills">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="skill_type"/>
                <field name="is_native"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="ow_ai_skill_view_form" model="ir.ui.view">
        <field name="name">ow.ai.skill.view.form</field>
        <field name="model">ow.ai.skill</field>
        <field name="arch" type="xml">
            <form string="AI Skill">
                <sheet>
                    <widget name="web_ribbon" title="Native" invisible="not is_native"/>
                    <div class="oe_title">
                        <field name="name" placeholder="Skill name" readonly="is_native"/>
                    </div>
                    <group>
                        <field name="skill_type" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Instructions">
                        <field name="instructions" nolabel="1"/>
                    </group>
                    <field name="tool_ids" readonly="is_native" groups="ow_ai.group_ai_manager">
                        <list>
                            <field name="name"/>
                            <field name="tool_name"/>
                            <field name="is_write"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ow_ai_skill_action" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">ow.ai.skill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
