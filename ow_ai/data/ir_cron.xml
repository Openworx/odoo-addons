<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Woken by ir.cron._trigger() whenever a job is enqueued; the
             one-minute interval is only a fallback. -->
        <record id="ir_cron_job_runner" model="ir.cron">
            <field name="name">AI: run agent jobs</field>
            <field name="model_id" ref="model_ow_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="priority">1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_job_sweeper" model="ir.cron">
            <field name="name">AI: sweep stale jobs</field>
            <field name="model_id" ref="model_ow_ai_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_sweep()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
