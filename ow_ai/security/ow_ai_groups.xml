<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="privilege_ai" model="res.groups.privilege">
            <field name="name">AI</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_ai_user" model="res.groups">
            <field name="name">AI User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_ai"/>
        </record>

        <record id="group_ai_manager" model="res.groups">
            <field name="name">AI Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_ai"/>
            <field name="implied_ids" eval="[(4, ref('ow_ai.group_ai_user'))]"/>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('ow_ai.group_ai_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('ow_ai.group_ai_manager'))]"/>
        </record>
    </data>
</odoo>
