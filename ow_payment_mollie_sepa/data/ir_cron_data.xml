<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_sepa_process_collections" model="ir.cron">
            <field name="name">Mollie SEPA: send scheduled direct debits</field>
            <field name="model_id" ref="model_mollie_sepa_batch"/>
            <field name="state">code</field>
            <field name="code">model._sepa_cron_process_collections()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sepa_refresh_pending_transactions" model="ir.cron">
            <field name="name">Mollie SEPA: poll pending direct debits</field>
            <field name="model_id" ref="payment.model_payment_provider"/>
            <field name="state">code</field>
            <field name="code">model._sepa_cron_refresh_pending_transactions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sepa_sync_mandates" model="ir.cron">
            <field name="name">Mollie SEPA: sync mandate statuses</field>
            <field name="model_id" ref="payment.model_payment_provider"/>
            <field name="state">code</field>
            <field name="code">model._sepa_cron_sync_mandates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sepa_auto_collect" model="ir.cron">
            <field name="name">Mollie SEPA: automatic daily collection</field>
            <field name="model_id" ref="payment.model_payment_provider"/>
            <field name="state">code</field>
            <field name="code">model._sepa_cron_auto_collect()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Daily at 05:00 UTC (06:00/07:00 in the Netherlands). -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
