<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_mollie_sepa_batch" model="ir.sequence">
            <field name="name">Mollie SEPA Collection Batch</field>
            <field name="code">mollie.sepa.batch</field>
            <field name="prefix">INC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_mollie_sepa_mandate_reference" model="ir.sequence">
            <field name="name">Mollie SEPA Mandate Reference</field>
            <field name="code">mollie.sepa.mandate.reference</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
