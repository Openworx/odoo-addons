<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_sepa" model="ir.ui.view">
        <field name="name">account.move.form.sepa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sepa_collect" type="object"
                        string="SEPA Direct Debit" class="btn btn-secondary"
                        groups="account.group_account_manager"
                        invisible="move_type != 'out_invoice' or state != 'posted' or amount_residual &lt;= 0 or sepa_line_state in ('draft', 'pending') or not sepa_mandate_available"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="sepa_line_state" invisible="sepa_line_state == 'none'"
                       widget="badge"
                       decoration-success="sepa_line_state == 'done'"
                       decoration-warning="sepa_line_state == 'pending'"
                       decoration-danger="sepa_line_state in ('failed', 'charged_back')"/>
                <field name="sepa_mandate_available" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
