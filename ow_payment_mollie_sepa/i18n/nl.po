#. module: ow_payment_mollie_sepa
#: model:ir.actions.report,print_report_name:ow_payment_mollie_sepa.action_report_sepa_mandate
msgid "'SEPA mandate - %s' % object.name"
msgstr "'SEPA-machtiging - %s' % object.name"

#. module: ow_payment_mollie_sepa
#: model:mail.template,body_html:ow_payment_mollie_sepa.mail_template_sepa_mandate_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-out=\"object.name or ''\">customer</t>,</p>\n"
"    <p>\n"
"        From now on we would like to collect our invoices by SEPA direct debit. Please\n"
"        authorize this through the link below. You confirm your bank account with a\n"
"        symbolic payment of EUR 0.01 through your bank; this amount is not invoiced.\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object.get_sepa_mandate_url()\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; border-radius: 5px; text-decoration: none;\">\n"
"            Grant SEPA direct debit mandate\n"
"        </a>\n"
"    </p>\n"
"    <p>You can withdraw the mandate at any time through your bank or by contacting us.</p>\n"
"    <p>Kind regards,<br/><t t-out=\"(object.company_id or user.company_id).name or ''\"/></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Beste <t t-out=\"object.name or ''\">klant</t>,</p>\n"
"    <p>\n"
"        Voortaan willen wij onze facturen via SEPA automatische incasso innen. Wilt u\n"
"        hiervoor toestemming geven via de link hieronder? U bevestigt uw bankrekening met\n"
"        een symbolische betaling van EUR 0,01 via uw bank; dit bedrag wordt niet gefactureerd.\n"
"    </p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object.get_sepa_mandate_url()\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; border-radius: 5px; text-decoration: none;\">\n"
"            Machtiging automatische incasso afgeven\n"
"        </a>\n"
"    </p>\n"
"    <p>U kunt de machtiging altijd intrekken via uw bank of door contact met ons op te nemen.</p>\n"
"    <p>Met vriendelijke groet,<br/><t t-out=\"(object.company_id or user.company_id).name or ''\"/></p>\n"
"</div>\n"
"            "

