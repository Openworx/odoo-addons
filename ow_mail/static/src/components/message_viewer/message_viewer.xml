<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ow_mail.MessageViewer">
    <section class="o-ow-viewer flex-grow-1 d-flex flex-column"
             role="region" aria-label="Message">
        <t t-if="!this.state.selectedMessage">
            <div class="d-flex flex-grow-1 justify-content-center align-items-center text-muted">
                <div class="text-center">
                    <i class="oi oi-3x mb-3" data-icon="mail"/>
                    <div>Select a message to read</div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div t-if="!this.isMobile" class="o-ow-viewer-toolbar border-bottom px-3 py-2 d-flex gap-2 flex-wrap"
                 role="toolbar" aria-label="Message actions">
                <button class="btn btn-sm btn-primary" t-on-click="() => this.onReply(false)">
                    <i class="oi" data-icon="reply"/> Reply
                </button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.onReply(true)">
                    <i class="oi" data-icon="reply_all"/> Reply all
                </button>
                <button class="btn btn-sm btn-light" t-on-click="this.onForward">
                    <i class="oi" data-icon="forward"/> Forward
                </button>
                <div class="border-start mx-1"/>
                <button class="btn btn-sm btn-light" t-on-click="this.onToggleRead"
                        t-att-title="this.state.selectedMessage.flags.seen ? 'Mark unread' : 'Mark read'">
                    <i class="oi" t-att-data-icon="this.state.selectedMessage.flags.seen ? 'mail' : 'drafts'"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="this.onToggleFlag"
                        t-att-title="this.state.selectedMessage.flags.flagged ? 'Remove star' : 'Star'">
                    <i t-att-class="this.state.selectedMessage.flags.flagged ? 'oi text-warning' : 'oi'" t-att-data-icon="this.state.selectedMessage.flags.flagged ? 'star_f' : 'star'"/>
                </button>
                <select class="form-select form-select-sm" style="width:auto;" t-on-change="this.onMove">
                    <option value="">Move to…</option>
                    <t t-foreach="this.moveTargetFolders" t-as="f" t-key="f.id">
                        <option t-att-value="f.id" t-out="f.name"/>
                    </t>
                </select>
                <div class="flex-grow-1"/>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="Create record from email">
                        <i class="oi" data-icon="add_box"/> Create
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <t t-foreach="this.state.createMenu" t-as="entry" t-key="entry.key">
                            <li>
                                <button class="dropdown-item" t-on-click="() => this.onCreateFromMenu(entry)">
                                    <i class="oi me-2" t-att-data-icon="entry.icon"/> <t t-out="entry.label"/>
                                </button>
                            </li>
                        </t>
                        <li>
                            <button class="dropdown-item" t-on-click="this.onCreateOther">
                                <i class="oi me-2" data-icon="more_horiz"/> Other…
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"/></li>
                        <li>
                            <button class="dropdown-item" t-on-click="this.onAttach">
                                <i class="oi me-2" data-icon="link"/> Attach to existing record…
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="border-start mx-1"/>
                <button class="btn btn-sm btn-light" t-on-click="this.onPrint" title="Print">
                    <i class="oi" data-icon="print"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="this.onViewSource" title="View original">
                    <i class="oi" data-icon="code"/>
                </button>
                <button class="btn btn-sm btn-light"
                        t-if="this.state.selectedMessage.partner_id"
                        t-on-click="this.onOpenContact" title="Open contact">
                    <i class="oi" data-icon="person"/>
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-success dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="Save sender">
                        <i class="oi" data-icon="person_add"/>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" t-on-click="this.onSaveContact">
                                <i class="oi me-2" data-icon="badge"/> Save to personal contacts
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" t-on-click="this.onSavePartner">
                                <i class="oi me-2" data-icon="group"/> Save as Odoo contact
                            </button>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-sm btn-light" t-on-click="this.onArchive" title="Archive">
                    <i class="oi" data-icon="archive"/>
                </button>
                <button class="btn btn-sm btn-danger" t-on-click="this.onDelete" title="Delete">
                    <i class="oi" data-icon="delete"/>
                </button>
            </div>
            <!-- Mobile: single-row toolbar — primary action + star + create,
                 everything else behind the ⋯ overflow menu -->
            <div t-else="" class="o-ow-viewer-toolbar o-ow-toolbar-mobile border-bottom px-2 py-2 d-flex gap-2 align-items-center"
                 role="toolbar" aria-label="Message actions">
                <button class="btn btn-sm btn-primary" t-on-click="() => this.onReply(false)">
                    <i class="oi" data-icon="reply"/> Reply
                </button>
                <button class="btn btn-sm btn-light" t-on-click="this.onToggleFlag"
                        t-att-title="this.state.selectedMessage.flags.flagged ? 'Remove star' : 'Star'">
                    <i t-att-class="this.state.selectedMessage.flags.flagged ? 'oi text-warning' : 'oi'" t-att-data-icon="this.state.selectedMessage.flags.flagged ? 'star_f' : 'star'"/>
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="Create record from email">
                        <i class="oi" data-icon="add_box"/>
                    </button>
                    <ul class="dropdown-menu">
                        <t t-foreach="this.state.createMenu" t-as="entry" t-key="entry.key">
                            <li>
                                <button class="dropdown-item" t-on-click="() => this.onCreateFromMenu(entry)">
                                    <i class="oi me-2" t-att-data-icon="entry.icon"/> <t t-out="entry.label"/>
                                </button>
                            </li>
                        </t>
                        <li>
                            <button class="dropdown-item" t-on-click="this.onCreateOther">
                                <i class="oi me-2" data-icon="more_horiz"/> Other…
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"/></li>
                        <li>
                            <button class="dropdown-item" t-on-click="this.onAttach">
                                <i class="oi me-2" data-icon="link"/> Attach to existing record…
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="flex-grow-1"/>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="More actions" aria-label="More actions">
                        <i class="oi" data-icon="more_horiz"/>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end o-ow-overflow-menu">
                        <li><button class="dropdown-item" t-on-click="() => this.onReply(true)">
                            <i class="oi me-2" data-icon="reply_all"/> Reply all
                        </button></li>
                        <li><button class="dropdown-item" t-on-click="this.onForward">
                            <i class="oi me-2" data-icon="forward"/> Forward
                        </button></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><button class="dropdown-item" t-on-click="this.onToggleRead">
                            <i class="oi me-2" t-att-data-icon="this.state.selectedMessage.flags.seen ? 'mail' : 'drafts'"/>
                            <t t-if="this.state.selectedMessage.flags.seen">Mark unread</t>
                            <t t-else="">Mark read</t>
                        </button></li>
                        <li t-if="this.moveTargetFolders.length"><h6 class="dropdown-header">Move to…</h6></li>
                        <t t-foreach="this.moveTargetFolders" t-as="f" t-key="f.id">
                            <li><button class="dropdown-item" t-on-click="() => this.onMoveTo(f.id)">
                                <i class="oi me-2" data-icon="folder"/> <t t-out="f.name"/>
                            </button></li>
                        </t>
                        <li><hr class="dropdown-divider"/></li>
                        <li t-if="this.state.selectedMessage.partner_id">
                            <button class="dropdown-item" t-on-click="this.onOpenContact">
                                <i class="oi me-2" data-icon="person"/> Open contact
                            </button>
                        </li>
                        <li><button class="dropdown-item" t-on-click="this.onSaveContact">
                            <i class="oi me-2" data-icon="badge"/> Save to personal contacts
                        </button></li>
                        <li><button class="dropdown-item" t-on-click="this.onSavePartner">
                            <i class="oi me-2" data-icon="group"/> Save as Odoo contact
                        </button></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><button class="dropdown-item" t-on-click="this.onPrint">
                            <i class="oi me-2" data-icon="print"/> Print
                        </button></li>
                        <li><button class="dropdown-item" t-on-click="this.onViewSource">
                            <i class="oi me-2" data-icon="code"/> View original
                        </button></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><button class="dropdown-item" t-on-click="this.onArchive">
                            <i class="oi me-2" data-icon="archive"/> Archive
                        </button></li>
                        <li><button class="dropdown-item text-danger" t-on-click="this.onDelete">
                            <i class="oi me-2" data-icon="delete"/> Delete
                        </button></li>
                    </ul>
                </div>
            </div>
            <!-- Mobile: floating reply action — stays reachable after the
                 toolbar scrolls away in the single scroll context -->
            <button t-if="this.isMobile" class="btn btn-primary o-ow-reply-fab shadow"
                    t-on-click="() => this.onReply(false)" title="Reply" aria-label="Reply">
                <i class="oi" data-icon="reply"/>
            </button>
            <!-- Conversation thread view -->
            <t t-if="this.isThreadView">
                <div class="o-ow-thread-subject px-3 py-2 border-bottom d-flex align-items-center flex-wrap gap-1">
                    <h5 class="mb-0 flex-grow-1" t-out="this.threadSubject"/>
                    <span t-if="this.threadLinkedRecords.length" class="o-ow-linked d-flex align-items-center flex-wrap gap-1">
                        <span class="small text-muted fw-normal me-1"><i class="oi me-1" data-icon="link"/>Linked:</span>
                        <t t-foreach="this.threadLinkedRecords" t-as="lr" t-key="lr.model + ':' + lr.res_id">
                            <button class="btn btn-sm btn-outline-secondary o-ow-linked-btn"
                                    t-on-click="() => this.onOpenLinked(lr)"
                                    t-att-title="'Open ' + lr.display_name">
                                <t t-out="lr.display_name"/>
                            </button>
                        </t>
                    </span>
                    <span class="badge bg-secondary ms-2"><t t-out="this.state.threadMessages.length"/> messages</span>
                </div>
                <div class="o-ow-thread-body flex-grow-1 overflow-auto">
                    <t t-foreach="this.state.threadMessages" t-as="tm" t-key="tm.folder_id + ':' + tm.uid">
                        <div class="o-ow-thread-message border-bottom">
                            <div class="o-ow-thread-msg-header px-3 py-2 d-flex align-items-center"
                                 t-att-class="{'o-ow-thread-msg-collapsed': !this.isThreadMsgExpanded(tm)}"
                                 t-on-click="() => this.toggleThreadMsg(tm)">
                                <AvatarInitials name="tm.from_name" email="tm.from_email"/>
                                <div class="ms-2 flex-grow-1 overflow-hidden">
                                    <div class="d-flex align-items-center">
                                        <strong class="text-truncate" t-out="tm.from_name"/>
                                        <small class="text-muted ms-1" t-if="!this.isThreadMsgExpanded(tm)">
                                            — <t t-out="tm.to"/>
                                        </small>
                                    </div>
                                    <t t-if="this.isThreadMsgExpanded(tm)">
                                        <div class="small text-muted">
                                            To: <t t-out="tm.to"/>
                                            <t t-if="tm.cc"> · Cc: <t t-out="tm.cc"/></t>
                                        </div>
                                    </t>
                                </div>
                                <small class="text-muted ms-2 flex-shrink-0" t-out="this.formatThreadDate(tm.date)"/>
                                <i class="oi ms-2 text-muted"
                                   t-att-data-icon="this.isThreadMsgExpanded(tm) ? 'expand_less' : 'expand_more'"/>
                            </div>
                            <t t-if="this.isThreadMsgExpanded(tm)">
                                <div class="o-ow-thread-msg-body px-3">
                                    <iframe t-att-data-thread-iframe="tm.folder_id + ':' + tm.uid"
                                            class="w-100" sandbox="allow-same-origin allow-modals allow-popups allow-popups-to-escape-sandbox"
                                            style="border:0;min-height:100px;"/>
                                </div>
                                <div class="o-ow-viewer-attachments px-3 pb-3" t-if="tm.attachments and tm.attachments.length">
                                    <div class="small text-muted mb-1">Attachments</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <t t-foreach="tm.attachments" t-as="a" t-key="a.section">
                                            <div class="o-ow-att card p-2 d-flex flex-row align-items-center">
                                                <i class="oi oi-2x me-2"
                                                   t-att-data-icon="a.mimetype &amp;&amp; a.mimetype.startsWith('image/') ? 'image' : a.mimetype === 'application/pdf' ? 'picture_as_pdf' : 'description'"/>
                                                <div class="me-2">
                                                    <div class="small fw-bold text-truncate" style="max-width:180px;" t-out="a.name"/>
                                                    <div class="text-muted small"><t t-out="a.mimetype"/></div>
                                                </div>
                                                <a class="btn btn-sm btn-light" t-att-href="a.url" target="_blank" title="Open">
                                                    <i class="oi" data-icon="open_in_new"/>
                                                </a>
                                                <a class="btn btn-sm btn-light" t-att-href="a.url + '?download=1'" title="Download">
                                                    <i class="oi" data-icon="download"/>
                                                </a>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Single message view -->
            <t t-else="">
                <div class="o-ow-viewer-head px-3 py-2">
                    <h4 t-if="!this.isMobile" class="mb-2 d-flex align-items-center flex-wrap gap-1" tabindex="-1" t-ref="this.subjectRef">
                        <span t-out="this.state.selectedMessage.subject"/>
                        <button t-if="this.isDraft" class="btn btn-sm btn-link ms-2 p-0" t-on-click="this.onEditDraft"
                                title="Edit draft">
                            <i class="oi text-info" data-icon="edit_square"/>
                        </button>
                        <span t-if="this.state.selectedMessage.linked_records and this.state.selectedMessage.linked_records.length"
                              class="o-ow-linked ms-auto d-flex align-items-center flex-wrap gap-1">
                            <span class="small text-muted fw-normal me-1"><i class="oi me-1" data-icon="link"/>Linked:</span>
                            <t t-foreach="this.state.selectedMessage.linked_records" t-as="lr" t-key="lr.model + ':' + lr.res_id">
                                <button class="btn btn-sm btn-outline-secondary o-ow-linked-btn"
                                        t-on-click="() => this.onOpenLinked(lr)"
                                        t-att-title="'Open ' + lr.display_name">
                                    <t t-out="lr.display_name"/>
                                </button>
                            </t>
                        </span>
                    </h4>
                    <t t-if="this.isDraft">
                        <div class="alert alert-info py-2 px-3 d-flex align-items-center mb-2">
                            <i class="oi me-2" data-icon="info"/>
                            <span>This is a draft message.</span>
                            <button class="btn btn-sm btn-info ms-2" t-on-click="this.onEditDraft">Edit</button>
                        </div>
                    </t>
                    <div t-if="this.state.tags.length and !this.isDraft and !this.isMobile"
                         class="d-flex align-items-center flex-wrap gap-1 mb-2 o-ow-viewer-tags">
                        <span class="small text-muted me-1">Tags:</span>
                        <t t-foreach="this.state.tags" t-as="tag" t-key="tag.id">
                            <button class="badge rounded-pill o-ow-tag-toggle"
                                    t-att-class="{'o-ow-tag-on': this.messageHasTag(tag.id)}"
                                    t-att-style="this.tagToggleStyle(tag)"
                                    t-att-title="this.messageHasTag(tag.id) ? 'Remove tag' : 'Add tag'"
                                    t-on-click="() => this.onToggleTag(tag)">
                                <span t-if="!this.messageHasTag(tag.id)" class="o-ow-tag-dot me-1"
                                      t-att-style="this.tagDotStyle(tag)"/>
                                <t t-out="tag.name"/>
                            </button>
                        </t>
                    </div>
                    <div t-if="!this.isMobile" class="d-flex align-items-center">
                        <AvatarInitials name="this.state.selectedMessage.from_name"
                                        email="this.state.selectedMessage.from_email"/>
                        <div class="ms-2 flex-grow-1">
                            <div>
                                <strong t-out="this.state.selectedMessage.from_name"/>
                                <span class="text-muted ms-1">&lt;<t t-out="this.state.selectedMessage.from_email"/>&gt;</span>
                                <span t-if="this.state.selectedMessage.partner_id"
                                      class="badge rounded-pill o-ow-customer-badge ms-2"
                                      title="Sender is an Odoo contact">Customer</span>
                            </div>
                            <div class="small text-muted">
                                To: <t t-out="this.state.selectedMessage.to"/>
                                <t t-if="this.state.selectedMessage.cc">
                                    · Cc: <t t-out="this.state.selectedMessage.cc"/>
                                </t>
                            </div>
                        </div>
                        <small class="text-muted" t-out="this.fmtHeadDate(this.state.selectedMessage.date)"/>
                    </div>
                    <!-- Mobile: compact one-line header (subject lives in the
                         topbar); tap to expand recipients, full date and tags -->
                    <div t-if="this.isMobile" class="o-ow-head-mobile" t-on-click="this.toggleHead"
                         role="button" aria-label="Toggle message details">
                        <div class="d-flex align-items-center">
                            <AvatarInitials name="this.state.selectedMessage.from_name"
                                            email="this.state.selectedMessage.from_email"/>
                            <div class="ms-2 flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center">
                                    <strong class="text-truncate flex-grow-1"
                                            t-out="this.state.selectedMessage.from_name or this.state.selectedMessage.from_email"/>
                                    <small class="text-muted ms-2 flex-shrink-0"
                                           t-out="this.fmtHeadDate(this.state.selectedMessage.date)"/>
                                    <i class="oi ms-2 text-muted flex-shrink-0"
                                       t-att-data-icon="this.local.headExpanded ? 'expand_less' : 'expand_more'"/>
                                </div>
                                <div t-if="!this.local.headExpanded" class="small text-muted text-truncate">
                                    To: <t t-out="this.state.selectedMessage.to"/>
                                </div>
                            </div>
                        </div>
                        <div t-if="this.local.headExpanded" class="small mt-2">
                            <div><span class="text-muted">From:</span>
                                <t t-out="this.state.selectedMessage.from_name"/>
                                <span class="text-muted">&lt;<t t-out="this.state.selectedMessage.from_email"/>&gt;</span>
                                <span t-if="this.state.selectedMessage.partner_id"
                                      class="badge rounded-pill o-ow-customer-badge ms-1">Customer</span>
                            </div>
                            <div><span class="text-muted">To:</span> <t t-out="this.state.selectedMessage.to"/></div>
                            <div t-if="this.state.selectedMessage.cc">
                                <span class="text-muted">Cc:</span> <t t-out="this.state.selectedMessage.cc"/>
                            </div>
                            <div><span class="text-muted">Date:</span>
                                <t t-out="this.fmtHeadDate(this.state.selectedMessage.date)"/></div>
                            <div t-if="this.state.tags.length and !this.isDraft"
                                 class="d-flex align-items-center flex-wrap gap-1 mt-1 o-ow-viewer-tags">
                                <t t-foreach="this.state.tags" t-as="tag" t-key="tag.id">
                                    <button class="badge rounded-pill o-ow-tag-toggle"
                                            t-att-class="{'o-ow-tag-on': this.messageHasTag(tag.id)}"
                                            t-att-style="this.tagToggleStyle(tag)"
                                            t-on-click.stop="() => this.onToggleTag(tag)">
                                        <span t-if="!this.messageHasTag(tag.id)" class="o-ow-tag-dot me-1"
                                              t-att-style="this.tagDotStyle(tag)"/>
                                        <t t-out="tag.name"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div t-if="this.isMobile and this.state.selectedMessage.linked_records and this.state.selectedMessage.linked_records.length"
                         class="o-ow-linked d-flex align-items-center flex-wrap gap-1 mt-2">
                        <span class="small text-muted fw-normal me-1"><i class="oi me-1" data-icon="link"/>Linked:</span>
                        <t t-foreach="this.state.selectedMessage.linked_records" t-as="lr" t-key="lr.model + ':' + lr.res_id">
                            <button class="btn btn-sm btn-outline-secondary o-ow-linked-btn"
                                    t-on-click="() => this.onOpenLinked(lr)"
                                    t-att-title="'Open ' + lr.display_name">
                                <t t-out="lr.display_name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <t t-if="this.state.selectedMessage.has_remote_content and !this.local.showRemote">
                    <SafeModeBanner onShowOnce="() => this.onShowOnce()"
                                    onTrustSender="() => this.onTrustSender()"/>
                </t>
                <t t-if="this.state.selectedMessage.invite">
                    <div class="o-ow-invite mx-3 my-2 p-3 border rounded">
                        <div class="d-flex align-items-start">
                            <i class="oi oi-2x me-3 text-primary" data-icon="calendar_today"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold mb-1">
                                    <t t-out="this.state.selectedMessage.invite.summary or 'Invitation'"/>
                                </div>
                                <div class="small text-muted" t-if="this.formatInviteWhen()">
                                    <i class="oi me-1" data-icon="schedule"/>
                                    <t t-out="this.formatInviteWhen()"/>
                                </div>
                                <div class="small text-muted" t-if="this.state.selectedMessage.invite.location">
                                    <i class="oi me-1" data-icon="location_on"/>
                                    <t t-out="this.state.selectedMessage.invite.location"/>
                                </div>
                                <div class="small text-muted" t-if="this.state.selectedMessage.invite.organizer_email">
                                    <i class="oi me-1" data-icon="person"/>
                                    <t t-out="this.state.selectedMessage.invite.organizer_name or this.state.selectedMessage.invite.organizer_email"/>
                                    <span class="ms-1">&lt;<t t-out="this.state.selectedMessage.invite.organizer_email"/>&gt;</span>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <button class="btn btn-sm btn-primary" t-on-click="this.onAddToCalendar">
                                    <i class="oi me-1" data-icon="calendar_add_on"/> Add to Calendar
                                </button>
                                <a class="btn btn-sm btn-light" t-att-href="this.inviteIcsUrl()"
                                   t-if="this.inviteIcsUrl()" title="Download .ics">
                                    <i class="oi me-1" data-icon="download"/> .ics
                                </a>
                            </div>
                        </div>
                    </div>
                </t>
                <div class="o-ow-viewer-body flex-grow-1">
                    <!-- Mobile drops h-100 (its !important height would beat the
                         inline content-height that _fitIframe sets) -->
                    <iframe t-ref="this.iframeRef" t-att-class="this.isMobile ? 'w-100' : 'w-100 h-100'"
                            sandbox="allow-same-origin allow-modals allow-popups allow-popups-to-escape-sandbox"
                            style="border:0;"/>
                </div>
                <div class="o-ow-viewer-attachments border-top p-2"
                     t-if="this.state.selectedMessage.attachments.length">
                    <div class="small text-muted mb-1">Attachments</div>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="this.state.selectedMessage.attachments" t-as="a" t-key="a.section">
                            <div class="o-ow-att card p-2 d-flex flex-row align-items-center">
                                <i class="oi oi-2x me-2"
                                   t-att-data-icon="a.mimetype &amp;&amp; a.mimetype.startsWith('image/') ? 'image' : a.mimetype === 'application/pdf' ? 'picture_as_pdf' : 'description'"/>
                                <div class="me-2">
                                    <div class="small fw-bold text-truncate" style="max-width:180px;" t-out="a.name"/>
                                    <div class="text-muted small"><t t-out="a.mimetype"/></div>
                                </div>
                                <a class="btn btn-sm btn-light" t-att-href="a.url" target="_blank" title="Open">
                                    <i class="oi" data-icon="open_in_new"/>
                                </a>
                                <a class="btn btn-sm btn-light" t-att-href="a.url + '?download=1'" title="Download">
                                    <i class="oi" data-icon="download"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </section>
</t>

</templates>
