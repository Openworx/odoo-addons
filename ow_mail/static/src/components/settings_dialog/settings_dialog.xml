<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ow_mail.SettingsDialog">
    <Dialog title="this.title" size="'md'">
        <div class="o-ow-settings" t-att-class="this.themeClass">
            <div class="mb-3">
                <label class="form-label fw-semibold" for="ow-settings-mark-read">Mark as read</label>
                <select id="ow-settings-mark-read" class="form-select"
                        t-custom-model="this.local.mark_read_delay">
                    <t t-foreach="this.delayOptions" t-as="opt" t-key="opt.value">
                        <option t-att-value="opt.value" t-out="opt.label"/>
                    </t>
                </select>
                <div class="form-text">
                    When an opened message is marked as read.
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="ow-settings-theme">Theme</label>
                <select id="ow-settings-theme" class="form-select" t-custom-model="this.local.theme">
                    <t t-foreach="this.themeOptions" t-as="opt" t-key="opt.value">
                        <option t-att-value="opt.value" t-out="opt.label"/>
                    </t>
                </select>
                <div class="form-text">
                    "Follow Odoo theme / system" tracks the backend dark-mode
                    toggle when a theme module provides one, otherwise your
                    operating system preference.
                </div>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="ow-settings-infinite-scroll"
                       t-custom-model="this.local.infinite_scroll"/>
                <label class="form-check-label" for="ow-settings-infinite-scroll">
                    Infinite scrolling in the message list
                </label>
                <div class="form-text">
                    Loads more messages automatically while you scroll,
                    instead of pages of 50.
                </div>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="ow-settings-thread-default"
                       t-custom-model="this.local.thread_view_default"/>
                <label class="form-check-label" for="ow-settings-thread-default">
                    Conversation view by default
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="ow-settings-stacked-threads"
                       t-custom-model="this.local.stacked_threads"/>
                <label class="form-check-label" for="ow-settings-stacked-threads">
                    Stack conversations in the reading pane
                </label>
                <div class="form-text">
                    Show the whole conversation (including your replies) when
                    opening any message of a thread.
                </div>
            </div>
            <hr/>
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-light text-start" t-on-click="this.onOpenAccount"
                        t-att-disabled="!this.state.accounts.length">
                    <i class="fa fa-id-card-o me-2"/>Signature &amp; account settings…
                </button>
                <button class="btn btn-light text-start" t-on-click="this.onShowShortcuts">
                    <i class="fa fa-keyboard-o me-2"/>Keyboard shortcuts…
                </button>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="this.onSave">Save</button>
            <button class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
        </t>
    </Dialog>
</t>

</templates>
