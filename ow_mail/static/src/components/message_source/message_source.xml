<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ow_mail.MessageSourceDialog">
    <Dialog title="this.title" size="'xl'">
        <div t-att-class="this.themeClass">
            <div t-if="this.state.loading" class="text-center p-3 text-muted">
                <i class="fa fa-spinner fa-spin me-2"/> Loading…
            </div>
            <div t-elif="this.state.error" class="alert alert-danger mb-0" t-out="this.state.error"/>
            <pre t-else="" class="o-ow-source-pre mb-0" t-out="this.state.text"/>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-light" t-on-click="this.openInTab">
                <i class="fa fa-external-link me-1"/> Open in new tab
            </button>
            <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                Close
            </button>
        </t>
    </Dialog>
</t>

</templates>
