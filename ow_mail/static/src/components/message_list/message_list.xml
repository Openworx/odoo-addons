<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ow_mail.MessageList">
    <section class="o-ow-list d-flex flex-column border-end"
             role="region" aria-label="Message list">
        <div class="o-ow-list-toolbar px-3 pt-2 pb-2 border-bottom">
            <div class="o-ow-search-row position-relative">
                <i class="oi position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" data-icon="search"/>
                <input type="text"
                       class="form-control rounded-pill ps-5 o-ow-search-input"
                       style="padding-right:4.5rem;"
                       placeholder="Search — from: subject: has:attachment before:YYYY-MM-DD …"
                       t-model.proxy="this.local.search"
                       t-on-keydown="this.onSearchKey"
                       t-on-input="this.onSearchInput"/>
                <div class="position-absolute top-50 end-0 translate-middle-y me-2 d-flex align-items-center">
                    <button t-if="this.local.search"
                            class="btn btn-sm btn-link text-muted p-0 me-1"
                            t-on-click="this.onClearSearch" title="Clear">
                        <i class="oi" data-icon="close"/>
                    </button>
                    <div class="dropdown d-inline-block" t-if="!this.local.search">
                        <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"
                                title="Search operators" aria-expanded="false">
                            <i class="oi" data-icon="help"/>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-2 small" style="min-width:280px;">
                            <li class="fw-bold small text-muted mb-1">Search operators</li>
                            <li><code>from:</code>, <code>to:</code>, <code>cc:</code> — address substring</li>
                            <li><code>subject:</code>, <code>body:</code> — text in field</li>
                            <li><code>label:</code> — messages with a tag</li>
                            <li><code>is:unread</code>, <code>is:read</code>, <code>is:starred</code></li>
                            <li><code>has:attachment</code></li>
                            <li><code>before:YYYY-MM-DD</code>, <code>since:YYYY-MM-DD</code>, <code>on:YYYY-MM-DD</code></li>
                            <li><code>older_than:7d</code>, <code>newer_than:30d</code></li>
                            <li class="text-muted mt-1">Use quotes for phrases: <code>subject:"weekly report"</code></li>
                        </ul>
                    </div>
                    <div class="dropdown d-inline-block ms-1">
                        <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"
                                aria-expanded="false"
                                t-att-title="this.activeFilterLabel()">
                            <i class="oi" data-icon="filter_alt"/>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-1" style="min-width:220px;">
                            <t t-foreach="this.filters" t-as="f" t-key="f.id">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2"
                                            t-on-click="() => this.onFilter(f.id)">
                                        <i class="oi" data-icon="check" style="width:1em;"
                                           t-att-style="this.isFilterActive(f.id) ? 'width:1em;' : 'width:1em;visibility:hidden;'"/>
                                        <i class="oi" t-att-data-icon="f.icon" style="width:1em;"/>
                                        <span t-out="f.label"/>
                                    </button>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="o-ow-list-header px-3 py-2 border-bottom d-flex align-items-center">
            <input type="checkbox" class="form-check-input me-2 mt-0"
                   t-att-checked="this.allChecked"
                   t-on-change="this.onToggleAll"
                   title="Select all"/>
            <strong>Messages</strong>
            <span class="text-muted small ms-2" t-out="this.state.totalMessages"/>
            <span t-if="this.state.loading" class="spinner-border spinner-border-sm ms-2"/>
            <div class="ms-auto d-flex align-items-center gap-1">
                <button class="btn btn-sm p-0 me-1"
                        t-att-class="this.state.threadView ? 'btn-link text-primary' : 'btn-link text-muted'"
                        t-on-click="this.onToggleThreadView"
                        title="Toggle conversation view">
                    <i class="oi" data-icon="forum"/>
                </button>
                <select class="form-select form-select-sm border-0 text-muted"
                        style="width:auto;font-size:0.8rem;"
                        t-on-change="this.onSortSelect">
                    <t t-foreach="this.sortOptions" t-as="s" t-key="s.id">
                        <option t-att-value="s.id" t-att-selected="this.state.sortBy === s.id" t-out="s.label"/>
                    </t>
                </select>
                <button class="btn btn-sm btn-link text-muted p-0" t-on-click="this.onToggleSortOrder"
                        title="Toggle sort order">
                    <i class="oi" t-att-data-icon="this.state.sortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward'"/>
                </button>
            </div>
        </div>
        <div t-if="this.checkedCount" class="o-ow-bulk-bar px-3 py-2 border-bottom d-flex align-items-center gap-2 flex-wrap"
             role="toolbar" aria-label="Bulk actions">
            <span class="fw-semibold small"><t t-out="this.checkedCount"/> selected</span>
            <button class="btn btn-sm btn-outline-secondary" t-on-click="this.onBulkArchive" title="Archive" aria-label="Archive">
                <i class="oi" data-icon="archive" aria-hidden="true"/>
            </button>
            <button class="btn btn-sm btn-outline-danger" t-on-click="this.onBulkDelete" title="Delete" aria-label="Delete">
                <i class="oi" data-icon="delete" aria-hidden="true"/>
            </button>
            <button class="btn btn-sm btn-outline-secondary" t-on-click="this.onBulkMarkRead" title="Mark read" aria-label="Mark read">
                <i class="oi" data-icon="drafts" aria-hidden="true"/>
            </button>
            <button class="btn btn-sm btn-outline-secondary" t-on-click="this.onBulkMarkUnread" title="Mark unread" aria-label="Mark unread">
                <i class="oi" data-icon="mail" aria-hidden="true"/>
            </button>
            <button class="btn btn-sm btn-outline-warning" t-on-click="this.onBulkToggleFlag" title="Star" aria-label="Star">
                <i class="oi" data-icon="star_f" aria-hidden="true"/>
            </button>
            <div class="dropdown" t-if="this.state.tags.length">
                <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                        aria-expanded="false" title="Label" aria-label="Label">
                    <i class="oi" data-icon="tag" aria-hidden="true"/>
                </button>
                <ul class="dropdown-menu p-1" style="min-width:210px;">
                    <li class="px-2 py-1 small text-muted">Click to add · × to remove</li>
                    <t t-foreach="this.state.tags" t-as="tag" t-key="tag.id">
                        <li class="d-flex align-items-center">
                            <button class="dropdown-item d-flex align-items-center gap-2 flex-grow-1"
                                    t-on-click="() => this.onBulkTag(tag.id, 'add')">
                                <span class="o-ow-tag-dot flex-shrink-0" t-att-style="this.tagDotStyle(tag)"/>
                                <span class="text-truncate" t-out="tag.name"/>
                            </button>
                            <button class="btn btn-sm btn-link text-muted p-0 mx-2 flex-shrink-0"
                                    t-att-title="'Remove ' + tag.name"
                                    t-att-aria-label="'Remove ' + tag.name"
                                    t-on-click="() => this.onBulkTag(tag.id, 'remove')">
                                <i class="oi" data-icon="close" aria-hidden="true"/>
                            </button>
                        </li>
                    </t>
                </ul>
            </div>
            <button class="btn btn-sm btn-outline-secondary" t-on-click="this.onBulkForward" title="Forward" aria-label="Forward">
                <i class="oi" data-icon="share" aria-hidden="true"/>
            </button>
            <select class="form-select form-select-sm" style="width:auto;" t-on-change="this.onBulkMove">
                <option value="">Move to…</option>
                <t t-foreach="this.moveTargetFolders" t-as="f" t-key="f.id">
                    <option t-att-value="f.id" t-out="f.name"/>
                </t>
            </select>
            <button class="btn btn-sm btn-link text-muted" t-on-click="this.clearChecked" title="Clear selection">
                <i class="oi" data-icon="close"/>
            </button>
        </div>
        <div class="o-ow-list-body flex-grow-1 overflow-auto" t-ref="this.listBodyRef"
             role="listbox" aria-label="Messages">
            <t t-if="!this.state.messages.length">
                <div class="text-muted text-center p-5">No messages</div>
            </t>

            <!-- Thread-grouped view -->
            <t t-elif="this.state.threadView">
                <t t-foreach="this.state.threads" t-as="thread" t-key="thread.threadId">
                    <div class="o-ow-list-item o-ow-thread-header px-3 py-2 border-bottom d-flex"
                         t-att-class="{'o-ow-unread': thread.has_unread}"
                         t-on-click="() => this.onToggleThread(thread)">
                        <input type="checkbox" class="form-check-input me-2 mt-0 o-ow-msg-check flex-shrink-0"
                               t-att-checked="this.isChecked(thread.messages[thread.messages.length - 1])"
                               t-on-click="(ev) => this.onToggleCheck(ev, thread.messages[thread.messages.length - 1])"/>
                        <i t-if="thread.messages.length > 1" class="oi me-2 o-ow-thread-toggle mt-1"
                           t-att-data-icon="this.isThreadExpanded(thread.threadId) ? 'expand_more' : 'chevron_right'"/>
                        <AvatarInitials name="thread.from_name" email="thread.from_email"/>
                        <div class="flex-grow-1 ms-2 overflow-hidden">
                            <div class="d-flex">
                                <div class="flex-grow-1 text-truncate"
                                     t-att-class="{'fw-bold': thread.has_unread}">
                                    <t t-out="thread.from_name"/>
                                </div>
                                <small class="text-muted ms-2" t-out="this.formatDate(thread.latestDate)"/>
                            </div>
                            <div class="text-truncate"
                                 t-att-class="{'fw-semibold': thread.has_unread}" t-out="thread.subject"/>
                        </div>
                        <div class="ms-1 d-flex flex-column align-items-end position-relative">
                            <div class="d-flex align-items-center gap-1">
                                <span t-if="thread.messages.length > 1"
                                      class="o-ow-thread-count" t-out="thread.messages.length"/>
                                <button class="btn btn-sm btn-link p-0 o-ow-star"
                                        t-on-click="(ev) => this.onToggleFlag(ev, thread.messages[thread.messages.length - 1])"
                                        title="Star">
                                    <i t-att-class="thread.has_flagged ? 'oi text-warning' : 'oi text-muted'" t-att-data-icon="thread.has_flagged ? 'star_f' : 'star'"/>
                                </button>
                            </div>
                            <i t-if="thread.has_attachments" class="oi text-muted small" data-icon="attach_file"/>
                        </div>
                        <div class="o-ow-hover-actions d-flex align-items-center gap-1">
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Reply"
                                    t-on-click="(ev) => this.onQuickReply(ev, thread.messages[thread.messages.length - 1])">
                                <i class="oi" data-icon="reply"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Forward"
                                    t-on-click="(ev) => this.onQuickForward(ev, thread.messages[thread.messages.length - 1])">
                                <i class="oi" data-icon="share"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Archive"
                                    t-on-click="(ev) => this.onArchive(ev, thread.messages[thread.messages.length - 1])">
                                <i class="oi" data-icon="archive"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn o-ow-delete"
                                    title="Delete"
                                    t-on-click="(ev) => this.onDelete(ev, thread.messages[thread.messages.length - 1])">
                                <i class="oi" data-icon="delete"/>
                            </button>
                        </div>
                    </div>
                    <t t-if="this.isThreadExpanded(thread.threadId)">
                        <t t-foreach="thread.messages" t-as="m" t-key="this.keyOf(m)">
                            <div class="o-ow-list-item o-ow-thread-child px-3 py-2 border-bottom d-flex"
                                 t-att-class="{'active': this.isSelected(m), 'o-ow-unread': !m.flags_seen}"
                                 t-on-click="() => this.onSelectThreadMessage(m)">
                                <input type="checkbox" class="form-check-input me-2 mt-0 o-ow-msg-check flex-shrink-0"
                                       t-att-checked="this.isChecked(m)"
                                       t-on-click="(ev) => this.onToggleCheck(ev, m)"/>
                                <div style="width:10px;"/>
                                <AvatarInitials name="m.from_name" email="m.from_email"/>
                                <div class="flex-grow-1 ms-2 overflow-hidden">
                                    <div class="d-flex">
                                        <div class="flex-grow-1 text-truncate"
                                             t-att-class="{'fw-bold': !m.flags_seen}">
                                            <t t-out="m.from_name"/>
                                        </div>
                                        <small class="text-muted ms-2" t-out="this.formatDate(m.date)"/>
                                    </div>
                                    <div class="text-muted small text-truncate" t-out="m.subject"/>
                                    <div t-if="this.hasChips(m)" class="mt-1 d-flex flex-wrap gap-1 o-ow-chip-row">
                                        <t t-foreach="this.tagsOf(m)" t-as="tag" t-key="tag.id">
                                            <span class="badge rounded-pill o-ow-tag-chip"
                                                  t-att-style="this.tagChipStyle(tag)" t-out="tag.name"/>
                                        </t>
                                        <span t-if="m.partner_id" class="badge rounded-pill o-ow-customer-badge"
                                              title="Sender is an Odoo contact">Customer</span>
                                    </div>
                                </div>
                                <div class="ms-1 d-flex flex-column align-items-end position-relative">
                                    <button class="btn btn-sm btn-link p-0 o-ow-star"
                                            t-on-click="(ev) => this.onToggleFlag(ev, m)"
                                            title="Star">
                                        <i t-att-class="m.flags_flagged ? 'oi text-warning' : 'oi text-muted'" t-att-data-icon="m.flags_flagged ? 'star_f' : 'star'"/>
                                    </button>
                                    <i t-if="m.has_attachments" class="oi text-muted small" data-icon="attach_file"/>
                                </div>
                                <div class="o-ow-hover-actions d-flex align-items-center gap-1">
                                    <button class="btn btn-sm o-ow-hover-btn"
                                            title="Reply"
                                            t-on-click="(ev) => this.onQuickReply(ev, m)">
                                        <i class="oi" data-icon="reply"/>
                                    </button>
                                    <button class="btn btn-sm o-ow-hover-btn"
                                            title="Forward"
                                            t-on-click="(ev) => this.onQuickForward(ev, m)">
                                        <i class="oi" data-icon="share"/>
                                    </button>
                                    <button class="btn btn-sm o-ow-hover-btn"
                                            title="Archive"
                                            t-on-click="(ev) => this.onArchive(ev, m)">
                                        <i class="oi" data-icon="archive"/>
                                    </button>
                                    <button class="btn btn-sm o-ow-hover-btn o-ow-delete"
                                            title="Delete"
                                            t-on-click="(ev) => this.onDelete(ev, m)">
                                        <i class="oi" data-icon="delete"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>

            <!-- Flat view (default) -->
            <t t-else="">
                <t t-foreach="this.state.messages" t-as="m" t-key="this.keyOf(m)">
                    <div class="o-ow-list-item px-3 py-2 border-bottom d-flex"
                         draggable="true" role="option" tabindex="-1"
                         t-att-aria-selected="this.isSelected(m) ? 'true' : 'false'"
                         t-att-aria-label="(m.flags_seen ? '' : 'Unread. ') + (m.from_name || m.from_email) + ': ' + m.subject"
                         t-att-class="{'active': this.isSelected(m), 'o-ow-unread': !m.flags_seen}"
                         t-on-click="() => this.onSelect(m)"
                         t-on-dblclick="() => this.onDblClick(m)"
                         t-on-keydown="(ev) => this.onRowKey(ev, m)"
                         t-on-dragstart="(ev) => this.onDragStart(ev, m)"
                         t-on-dragend="this.onDragEnd">
                        <input type="checkbox" class="form-check-input me-2 mt-0 o-ow-msg-check flex-shrink-0"
                               aria-label="Select message"
                               t-att-checked="this.isChecked(m)"
                               t-on-click="(ev) => this.onToggleCheck(ev, m)"/>
                        <AvatarInitials name="m.from_name" email="m.from_email"/>
                        <div class="flex-grow-1 ms-2 overflow-hidden">
                            <div class="d-flex">
                                <div class="flex-grow-1 text-truncate"
                                     t-att-class="{'fw-bold': !m.flags_seen}">
                                    <t t-out="m.from_name"/>
                                </div>
                                <small class="text-muted ms-2" t-out="this.formatDate(m.date)"/>
                            </div>
                            <div class="text-truncate"
                                 t-att-class="{'fw-semibold': !m.flags_seen}" t-out="m.subject"/>
                            <div class="text-muted small text-truncate" t-out="m.preview"/>
                            <div t-if="this.hasChips(m)" class="mt-1 d-flex flex-wrap gap-1 o-ow-chip-row">
                                <t t-foreach="this.tagsOf(m)" t-as="tag" t-key="tag.id">
                                    <span class="badge rounded-pill o-ow-tag-chip"
                                          t-att-style="this.tagChipStyle(tag)" t-out="tag.name"/>
                                </t>
                                <span t-if="m.partner_id" class="badge rounded-pill o-ow-customer-badge"
                                      title="Sender is an Odoo contact">Customer</span>
                            </div>
                        </div>
                        <div class="ms-1 d-flex flex-column align-items-end position-relative">
                            <button class="btn btn-sm btn-link p-0 o-ow-star"
                                    t-on-click="(ev) => this.onToggleFlag(ev, m)"
                                    title="Star">
                                <i t-att-class="m.flags_flagged ? 'oi text-warning' : 'oi text-muted'" t-att-data-icon="m.flags_flagged ? 'star_f' : 'star'"/>
                            </button>
                            <i t-if="m.has_attachments" class="oi text-muted small" data-icon="attach_file"/>
                        </div>
                        <div class="o-ow-hover-actions d-flex align-items-center gap-1">
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Reply"
                                    t-on-click="(ev) => this.onQuickReply(ev, m)">
                                <i class="oi" data-icon="reply"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Forward"
                                    t-on-click="(ev) => this.onQuickForward(ev, m)">
                                <i class="oi" data-icon="share"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn"
                                    title="Archive"
                                    t-on-click="(ev) => this.onArchive(ev, m)">
                                <i class="oi" data-icon="archive"/>
                            </button>
                            <button class="btn btn-sm o-ow-hover-btn o-ow-delete"
                                    title="Delete"
                                    t-on-click="(ev) => this.onDelete(ev, m)">
                                <i class="oi" data-icon="delete"/>
                            </button>
                        </div>
                    </div>
                </t>
            </t>
            <div t-if="this.state.prefs.infinite_scroll and this.state.messages.length and !this.state.listEnd"
                 t-ref="this.sentinelRef" class="o-ow-list-sentinel" aria-hidden="true"/>
        </div>
        <div t-if="this.state.totalMessages and this.state.prefs.infinite_scroll"
             class="o-ow-pager border-top px-3 py-2 d-flex align-items-center justify-content-center gap-2 small text-muted">
            <i t-if="this.state.loadingMore" class="oi oi-spin me-1" data-icon="progress_activity"/>
            <span><t t-out="this.state.messages.length"/> / <t t-out="this.state.totalMessages"/> messages</span>
        </div>
        <div t-if="this.state.totalMessages and !this.state.prefs.infinite_scroll" class="o-ow-pager border-top px-3 py-2 d-flex align-items-center justify-content-center gap-2">
            <button class="btn btn-sm btn-outline-secondary border-0" t-att-disabled="this.state.page === 1" t-on-click="this.onFirstPage" title="First">
                <i class="oi" data-icon="keyboard_double_arrow_left"/>
            </button>
            <button class="btn btn-sm btn-outline-secondary border-0" t-att-disabled="this.state.page === 1" t-on-click="this.onPrevPage" title="Previous">
                <i class="oi" data-icon="chevron_left"/>
            </button>
            <span class="text-muted small">
                Message <t t-out="this.rangeStart"/> to <t t-out="this.rangeEnd"/> of <t t-out="this.state.totalMessages"/>
            </span>
            <select class="form-select form-select-sm text-center"
                    style="width: auto;"
                    t-on-change="this.onPageSelect">
                <t t-foreach="this.pageList" t-as="p" t-key="p">
                    <option t-att-value="p" t-att-selected="p === this.state.page" t-out="p"/>
                </t>
            </select>
            <button class="btn btn-sm btn-outline-secondary border-0" t-att-disabled="this.state.page === this.totalPages" t-on-click="this.onNextPage" title="Next">
                <i class="oi" data-icon="chevron_right"/>
            </button>
            <button class="btn btn-sm btn-outline-secondary border-0" t-att-disabled="this.state.page === this.totalPages" t-on-click="this.onLastPage" title="Last">
                <i class="oi" data-icon="keyboard_double_arrow_right"/>
            </button>
        </div>
    </section>
</t>

</templates>
