<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ow_mail.ComposeWindow">
    <div class="o-ow-compose card shadow"
         t-att-class="{'o-ow-compose-min': this.props.win.minimized, 'o-ow-compose-modal': this.props.win.expanded}">
        <!-- Backdrop for modal mode -->
        <div t-if="this.props.win.expanded" class="o-ow-compose-backdrop" t-on-click="this.toggleExpand"/>

        <div class="o-ow-compose-inner card d-flex flex-column position-relative"
             t-ref="this.innerRef"
             t-att-class="{'shadow-lg': this.props.win.expanded}"
             t-on-dragenter="this.onDragEnter"
             t-on-dragover="this.onDragOver"
             t-on-dragleave="this.onDragLeave"
             t-on-drop="this.onDrop">
            <div t-if="this.local.dragActive" class="o-ow-dropzone">
                <div class="o-ow-dropzone-inner">
                    <i class="oi oi-3x mb-2" data-icon="cloud_upload"/>
                    <div>Drop files to attach</div>
                </div>
            </div>
            <!-- Header -->
            <div class="o-ow-compose-header card-header d-flex align-items-center py-1 px-3">
                <strong class="flex-grow-1 text-truncate">New Message</strong>
                <button class="btn btn-sm btn-link p-0 me-2 text-muted" t-on-click="this.toggleMin" title="Minimize">
                    <i class="oi" data-icon="remove"/>
                </button>
                <button class="btn btn-sm btn-link p-0 me-2 text-muted" t-on-click="this.toggleExpand"
                        t-att-title="this.props.win.expanded ? 'Restore' : 'Full screen'">
                    <i class="oi" t-att-data-icon="this.props.win.expanded ? 'close_fullscreen' : 'fullscreen'"/>
                </button>
                <button class="btn btn-sm btn-link p-0 text-muted" t-on-click="this.onClose" title="Close">
                    <i class="oi" data-icon="close"/>
                </button>
            </div>

            <div class="card-body p-0 d-flex flex-column" t-if="!this.props.win.minimized">
                <!-- Address fields -->
                <div class="o-ow-compose-fields px-3 pt-2">
                    <div class="mb-1">
                        <select class="form-select form-select-sm" t-custom-model.number="this.props.win.accountId">
                            <t t-foreach="this.state.accounts" t-as="a" t-key="a.id">
                                <option t-att-value="a.id" t-out="a.email"/>
                            </t>
                        </select>
                    </div>
                    <div class="mb-1">
                        <RecipientInput placeholder="'To'" value="this.props.win.to"
                                        onUpdate="(v) => this.onUpdateTo(v)"/>
                    </div>
                    <div class="mb-1">
                        <RecipientInput placeholder="'Cc'" value="this.props.win.cc"
                                        onUpdate="(v) => this.onUpdateCc(v)"/>
                    </div>
                    <div class="mb-1">
                        <RecipientInput placeholder="'Bcc'" value="this.props.win.bcc"
                                        onUpdate="(v) => this.onUpdateBcc(v)"/>
                    </div>
                    <input class="form-control form-control-sm mb-1" placeholder="Subject"
                           t-custom-model="this.props.win.subject" t-on-input="this.markDirty"/>
                </div>

                <!-- Toolbar -->
                <div class="o-ow-compose-toolbar d-flex align-items-center gap-1 px-3 py-1 border-top border-bottom">
                    <select class="form-select form-select-sm" style="width:auto;"
                            t-on-change="this.onFormatBlock">
                        <option value="p">Paragraph</option>
                        <option value="h1">Heading 1</option>
                        <option value="h2">Heading 2</option>
                        <option value="h3">Heading 3</option>
                        <option value="blockquote">Quote</option>
                        <option value="pre">Code</option>
                    </select>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('bold')" title="Bold"><b>B</b></button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('italic')" title="Italic"><i>I</i></button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('underline')" title="Underline"><u>U</u></button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('strikeThrough')" title="Strikethrough"><s>S</s></button>
                    <div class="vr mx-1"/>
                    <label class="btn btn-sm btn-light mb-0" title="Text color">
                        <i class="oi" data-icon="text_fields"/>
                        <input type="color" class="d-none" t-on-input="this.onTextColor"/>
                    </label>
                    <label class="btn btn-sm btn-light mb-0" title="Highlight color">
                        <i class="oi" data-icon="brush"/>
                        <input type="color" value="#ffff00" class="d-none" t-on-input="this.onHighlight"/>
                    </label>
                    <div class="vr mx-1"/>
                    <select class="form-select form-select-sm" style="width:auto;"
                            t-on-change="this.onFontSize">
                        <option value="">Size</option>
                        <option value="1">8</option>
                        <option value="2">10</option>
                        <option value="3">12</option>
                        <option value="4">14</option>
                        <option value="5">18</option>
                        <option value="6">24</option>
                        <option value="7">36</option>
                    </select>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('insertUnorderedList')" title="Bullet list">
                        <i class="oi" data-icon="format_list_bulleted"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('insertOrderedList')" title="Numbered list">
                        <i class="oi" data-icon="format_list_numbered"/>
                    </button>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('outdent')" title="Decrease indent">
                        <i class="oi" data-icon="format_indent_decrease"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('indent')" title="Increase indent">
                        <i class="oi" data-icon="format_indent_increase"/>
                    </button>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('justifyLeft')" title="Align left">
                        <i class="oi" data-icon="format_align_left"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('justifyCenter')" title="Align center">
                        <i class="oi" data-icon="format_align_center"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('justifyRight')" title="Align right">
                        <i class="oi" data-icon="format_align_right"/>
                    </button>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="this.insertLink" title="Insert link">
                        <i class="oi" data-icon="link"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('unlink')" title="Remove link">
                        <i class="oi" data-icon="link_off"/>
                    </button>
                    <label class="btn btn-sm btn-light mb-0" title="Insert image"
                           t-on-mousedown="this.onImageMousedown">
                        <i class="oi" data-icon="image"/>
                        <input type="file" accept="image/*" class="d-none" t-on-change="this.onInsertImage"/>
                    </label>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('insertHorizontalRule')" title="Horizontal rule">
                        <i class="oi" data-icon="remove"/>
                    </button>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('undo')" title="Undo">
                        <i class="oi" data-icon="undo"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('redo')" title="Redo">
                        <i class="oi" data-icon="repeat"/>
                    </button>
                    <div class="vr mx-1"/>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.exec('removeFormat')" title="Clear formatting">
                        <i class="oi" data-icon="ink_eraser"/>
                    </button>
                </div>

                <!-- Body -->
                <div class="o-ow-compose-body flex-grow-1 overflow-auto px-3 py-2"
                     contenteditable="true" t-ref="this.bodyRef"
                     t-on-input="this.onBodyInput"
                     t-on-click="this.onBodyClick"
                     t-on-paste="this.onPaste"
                     t-on-scroll="this.deselectImg"/>

                <!-- Image-resize overlay (selection border, size toolbar, drag handle) -->
                <t t-if="this.local.imgSel">
                    <div class="o-ow-img-outline"
                         t-att-style="'top:' + this.local.imgSel.top + 'px; left:' + this.local.imgSel.left + 'px; width:' + this.local.imgSel.width + 'px; height:' + this.local.imgSel.height + 'px;'"/>
                    <div class="o-ow-img-toolbar" role="toolbar" aria-label="Image size"
                         t-att-style="'top:' + this.local.imgSel.barTop + 'px; left:' + this.local.imgSel.left + 'px;'">
                        <button t-on-click="() => this.setImgWidth('25%')" aria-label="Width 25%">25%</button>
                        <button t-on-click="() => this.setImgWidth('50%')" aria-label="Width 50%">50%</button>
                        <button t-on-click="() => this.setImgWidth('75%')" aria-label="Width 75%">75%</button>
                        <button t-on-click="() => this.setImgWidth('100%')" aria-label="Width 100%">100%</button>
                        <button t-on-click="() => this.setImgWidth(null)" title="Original size"
                                aria-label="Original size"><i class="oi" data-icon="refresh"/></button>
                        <button class="o-ow-img-remove" t-on-click="this.removeSelectedImg"
                                title="Remove image" aria-label="Remove image"><i class="oi" data-icon="delete"/></button>
                    </div>
                    <span class="o-ow-img-handle" title="Drag to resize"
                          t-att-style="'top:' + (this.local.imgSel.top + this.local.imgSel.height - 7) + 'px; left:' + (this.local.imgSel.left + this.local.imgSel.width - 7) + 'px;'"
                          t-on-pointerdown="this.onImgHandleDown"/>
                </t>

                <!-- Attachments -->
                <div class="o-ow-compose-attachments px-3 pb-1" t-if="this.props.win.attachments.length">
                    <t t-foreach="this.props.win.attachments" t-as="a" t-key="a.id">
                        <div class="o-ow-att-item d-flex align-items-center px-2 py-1 mb-1 rounded">
                            <span class="flex-grow-1 text-truncate small fw-semibold" t-out="a.name"/>
                            <button class="btn btn-sm btn-link p-0 ms-2 text-muted"
                                    t-on-click="() => this.removeAttachment(a.id)"
                                    title="Remove attachment">
                                <i class="oi" data-icon="close"/>
                            </button>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer d-flex align-items-center px-3 py-2" t-if="!this.props.win.minimized">
                <label class="btn btn-sm btn-light mb-0 me-1" title="Attach file">
                    <i class="oi" data-icon="attach_file"/>
                    <input type="file" multiple="multiple" class="d-none" t-on-change="this.onAttach"/>
                </label>
                <button class="btn btn-sm btn-light me-1" t-on-click="this.onInsertSignature"
                        title="Insert signature">
                    <i class="oi" data-icon="badge"/>
                </button>
                <div class="flex-grow-1 text-center">
                    <small class="text-muted o-ow-save-status" t-out="this.saveStatus"/>
                </div>
                <button class="btn btn-sm btn-outline-secondary me-2" t-on-click="this.onDraft">
                    <i class="oi me-1" data-icon="save"/> Draft
                </button>
                <button class="btn btn-sm btn-primary" t-on-click="this.onSend">
                    <i class="oi me-1" data-icon="send"/> Send
                </button>
            </div>
        </div>
    </div>
</t>

</templates>
