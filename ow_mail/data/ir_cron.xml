<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ow_mail_counts" model="ir.cron">
            <field name="name">OW Mail: refresh folder counts</field>
            <field name="model_id" ref="model_ow_mail_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_counts()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_ow_mail_upload_gc" model="ir.cron">
            <field name="name">OW Mail: garbage-collect orphan upload attachments</field>
            <field name="model_id" ref="model_ow_mail_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_orphan_uploads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
