<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ow_mail_create_record_view_form" model="ir.ui.view">
        <field name="name">ow.mail.create.record.form</field>
        <field name="model">ow.mail.create.record</field>
        <field name="arch" type="xml">
            <form string="Create Record from Mail">
                <group>
                    <field name="res_model_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="subject"/>
                    <field name="from_name"/>
                    <field name="from_email"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
