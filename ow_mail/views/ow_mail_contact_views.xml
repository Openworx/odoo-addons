<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ow_mail_contact_tree" model="ir.ui.view">
        <field name="name">ow.mail.contact.tree</field>
        <field name="model">ow.mail.contact</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="company"/>
                <field name="phone"/>
                <field name="last_used"/>
            </list>
        </field>
    </record>

    <record id="view_ow_mail_contact_form" model="ir.ui.view">
        <field name="name">ow.mail.contact.form</field>
        <field name="model">ow.mail.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="company"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ow_mail_contact_search" model="ir.ui.view">
        <field name="name">ow.mail.contact.search</field>
        <field name="model">ow.mail.contact</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="company"/>
            </search>
        </field>
    </record>

    <record id="action_ow_mail_contact" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">ow.mail.contact</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
