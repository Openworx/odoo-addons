<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ow_mail_tag_tree" model="ir.ui.view">
        <field name="name">ow.mail.tag.tree</field>
        <field name="model">ow.mail.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="imap_keyword"/>
            </list>
        </field>
    </record>
    <record id="action_ow_mail_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">ow.mail.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
